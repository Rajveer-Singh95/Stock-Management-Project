# =============================================
# Smart Inventory Backend — Environment Config
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────
# PostgreSQL — Get this from Neon.tech
# 1. Sign up at https://neon.tech
# 2. Create a new project → copy the connection string
# ──────────────────────────────────────────
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# ──────────────────────────────────────────
# Redis — Get this from Upstash
# 1. Sign up at https://upstash.com
# 2. Create a Redis database → copy the Redis URL
# ──────────────────────────────────────────
REDIS_URL=rediss://default:password@host:6380

# ──────────────────────────────────────────
# JWT Secret — Generate a strong random secret
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ──────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
